---
import Icon from './Icon.astro';
import { url } from '../data/site';
interface Props {
  project: {
    number: string;
    title: string;
    description: string;
    tags: string[];
    status: string;
    type: string;
    preview: string;
    href: string;
  };
}
const { project } = Astro.props;
const href = project.href.startsWith('#') ? project.href : url(project.href);
---

<a class="project-card" href={href}>
  <div class:list={['project-preview', `preview-${project.preview}`]} aria-hidden="true">
    <span class="preview-label mono">
      {project.type} / {project.number}
    </span>
    {project.preview === 'site' ? (
      <div class="mini-browser">
        <div class="mini-browser-bar">
          <span></span>
          <span></span>
          <span></span>
          <i>luyvzz.github.io</i>
        </div>
        <div class="mini-browser-body">
          <div class="mini-sidebar">
            <b>✳</b>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="mini-content">
            <small>HELLO, WORLD.</small>
            <strong>
              让想法
              <br />
              有迹可循<span>↗</span>
            </strong>
            <div class="mini-lines">
              <i></i>
              <i></i>
            </div>
            <div class="mini-blocks">
              <i></i>
              <i></i>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="mini-terminal mono">
        <div class="terminal-dots">
          <i></i>
          <i></i>
          <i></i>
          <span>~/playground</span>
        </div>
        <p>
          <em>❯</em> hello world<span class="mini-cursor">▌</span>
        </p>
        <p class="mini-terminal-output">A little curiosity goes a long way.</p>
        <div class="mini-terminal-ascii">[ make something cool_ ]</div>
      </div>
    )}
    <span class="preview-open">
      <Icon name="external" size={17} />
    </span>
  </div>
  <div class="project-copy">
    <div class="project-title">
      <h3>{project.title}</h3>
      <Icon name="external" size={19} />
    </div>
    <p>{project.description}</p>
    <div class="project-meta">
      <div class="tags">
        {project.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
      <span class="project-status">
        <i></i>
        {project.status}
      </span>
    </div>
  </div>
</a>
