---
import Icon from '../components/Icon.astro';
import { profile, navigation, url } from '../data/site';
import '../styles/global.css';
interface Props {
  title?: string;
  active?: string;
  breadcrumb?: string;
  description?: string;
}
const {
  title = '保持好奇，持续构建',
  active = 'index',
  breadcrumb = 'index',
  description = profile.description,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f9f6" />
    <meta property="og:title" content={`${title} · ${profile.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <title>{title} · {profile.name}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('luyu-theme');
        document.documentElement.dataset.theme =
          saved === 'dark' ||
          (saved !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
            ? 'dark'
            : 'light';
      } catch {}
    </script>
  </head>
  <body data-base={url()}>
    <a href="#main" class="skip-link">
      跳到正文
    </a>
    <div class="mobile-overlay" id="mobile-overlay" hidden></div>
    <aside class="sidebar" id="sidebar" aria-label="主导航">
      <a class="identity" href={url()} aria-label="鹿屿，返回首页">
        <span class="brand-mark">✳</span>
        <span>
          <strong>
            {profile.name}
            <span class="brand-period">.</span>
          </strong>
          <small>@{profile.handle}</small>
        </span>
      </a>
      <button class="search-trigger" data-open-command>
        <Icon name="search" size={16} />
        <span>快速前往…</span>
        <kbd>⌘ K</kbd>
      </button>
      <div class="sidebar-heading mono">
        EXPLORER <span>−</span>
      </div>
      <div class="tree-root">
        <span class="tree-caret">⌄</span>
        <Icon name="folder" size={15} />
        <span>luyu-space</span>
      </div>
      <nav class="nav-tree">
        {navigation.map((item) => (
          <a
            href={url(item.path)}
            class:list={['nav-item', { active: active === item.file }]}
            aria-current={active === item.file ? 'page' : undefined}
          >
            <Icon name={item.icon} size={17} />
            <span>{item.label}</span>
            <span class="nav-file">
              {item.file}
              {item.file === 'index' || item.file === 'about' ? '.md' : '/'}
            </span>
          </a>
        ))}
      </nav>
      <div class="sidebar-heading elsewhere mono">ELSEWHERE</div>
      <a class="social-nav" href={profile.github} target="_blank" rel="noopener noreferrer">
        <Icon name="github" size={17} />
        <span>GitHub</span>
        <Icon name="external" size={15} />
      </a>
      <a class="social-nav" href={url('about/#contact')}>
        <Icon name="mail" size={17} />
        <span>联系我</span>
        <Icon name="external" size={15} />
      </a>
      <div class="sidebar-bottom">
        <div class="sidebar-note">
          <span class="status-dot"></span> 好奇心，在线中<span class="mono">:)</span>
        </div>
        <div class="sidebar-bottom-row">
          <span class="mono">v1.0.0</span>
          <button class="icon-button theme-toggle" aria-label="切换深浅主题" title="切换深浅主题">
            <Icon name="sun" class="light-icon" />
            <Icon name="moon" class="dark-icon" />
          </button>
        </div>
      </div>
    </aside>
    <div class="workspace">
      <header class="topbar">
        <button
          class="icon-button mobile-menu"
          id="mobile-menu"
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="打开导航"
        >
          <Icon name="menu" />
        </button>
        <div class="breadcrumb mono">
          <span>~</span>
          <span>/</span>
          <span>luyu-space</span>
          <span>/</span>
          <strong>{breadcrumb}</strong>
        </div>
        <div class="topbar-right">
          <span class="branch mono">
            <span>⑂</span> main
          </span>
          <button class="icon-button top-command" data-open-command aria-label="打开快捷命令">
            <Icon name="search" size={17} />
          </button>
        </div>
      </header>
      <main id="main" class="main-content" tabindex="-1">
        <slot />
      </main>
      <footer class="footer">
        <span>
          © {new Date().getFullYear()} {profile.name} <span class="footer-separator">/</span>{' '}
          用好奇心驱动，用代码记录。
        </span>
        <a href={url('about/#this-site')} class="mono">
          Built with Astro <span>↗</span>
        </a>
      </footer>
    </div>
    <dialog id="command-dialog" class="command-dialog" aria-labelledby="command-title">
      <div class="command-header">
        <Icon name="search" />
        <label class="sr-only" id="command-title" for="command-search">
          搜索快捷命令
        </label>
        <input
          id="command-search"
          type="search"
          placeholder="想去哪里？试试「项目」或「主题」"
          autocomplete="off"
        />
        <button class="icon-button" data-close-command aria-label="关闭快捷命令">
          <Icon name="close" />
        </button>
      </div>
      <div class="command-options">
        {navigation.map((item) => (
          <a
            class="command-option"
            data-keywords={`${item.label} ${item.file}`}
            href={url(item.path)}
          >
            <Icon name={item.icon} />
            <span>前往{item.label}</span>
            <span class="mono">↵</span>
          </a>
        ))}
        <button class="command-option theme-toggle" data-keywords="主题 theme dark light 深色 浅色">
          <Icon name="sun" />
          <span>切换深浅主题</span>
          <span class="mono">↵</span>
        </button>
        <a class="command-option" data-keywords="terminal 终端" href={url('#terminal')}>
          <Icon name="terminal" />
          <span>打开迷你终端</span>
          <span class="mono">↵</span>
        </a>
        <a
          class="command-option"
          data-keywords="github 源码"
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="github" />
          <span>在 GitHub 找到我</span>
          <span class="mono">↗</span>
        </a>
        <p id="command-empty" hidden>
          没有找到命令，试试「首页」「笔记」或「主题」。
        </p>
      </div>
      <div class="command-footer">
        <span>
          <kbd>↑</kbd> <kbd>↓</kbd> 选择 <kbd>Enter</kbd> 前往
        </span>
        <span>
          <kbd>Esc</kbd> 关闭
        </span>
      </div>
    </dialog>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
