---
import Icon from './Icon.astro';
import { url } from '../data/site';
import ProjectPreview from './ProjectPreview.astro';
import type { Project } from '../data/projects';
interface Props {
  project: Project;
}
const { project } = Astro.props;
const href = url(`projects/${project.id}/`);
---

<a class="project-card" href={href}>
  <ProjectPreview variant={project.preview} number={project.number} type={project.type} />
  <div class="project-copy">
    <div class="project-title">
      <h3>{project.title}</h3>
      <Icon name="arrow" size={19} />
    </div>
    <span class="repo-name mono">{project.repoName}</span>
    <p>{project.description}</p>
    <div class="project-meta">
      <div class="tags">
        {project.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
      <span class="project-status">
        <i></i>
        {project.status}
      </span>
    </div>
  </div>
</a>
<style>
  .repo-name {
    display: block;
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.3px;
    margin-top: 4px;
    overflow-wrap: anywhere;
  }
  .project-card {
    display: flex;
    flex-direction: column;
  }
  .project-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .project-meta {
    margin-top: auto;
    padding-top: 20px;
  }
  .project-title h3 {
    overflow-wrap: anywhere;
  }
</style>
