---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Terminal from '../components/Terminal.astro';
import Icon from '../components/Icon.astro';
import { projects, profile, url } from '../data/site';
---

<Base title="项目" active="projects" breadcrumb="projects">
  <section class="page-intro">
    <span class="eyebrow mono">THINK. BUILD. ITERATE.</span>
    <h1>
      做点有意思的东西<span class="heading-dot">.</span>
    </h1>
    <p>
      从 AI 工作流到电子工程，把重复的步骤做成可以复用的工具。
      <br />
      这里记录我的开源项目、实现思路，以及它们适合解决的问题。
    </p>
    <div class="project-index-meta">
      <span class="page-count mono">
        {String(projects.length).padStart(2, '0')} OPEN-SOURCE PROJECTS
      </span>
      <a
        class="text-link"
        href={`${profile.github}?tab=repositories`}
        target="_blank"
        rel="noopener noreferrer"
      >
        全部 GitHub 仓库
        <Icon name="external" size={16} />
      </a>
    </div>
  </section>
  <div class="project-grid">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
  <div class="build-note">
    <span class="mono">// this website is a project, too.</span>
    <p>
      这个小站也在持续构建：Astro 静态页面、Markdown 笔记，以及一点可玩的交互。
      <a href={url('about/#this-site')}>了解这个网站 →</a>
    </p>
  </div>
  <Terminal />
</Base>
<style>
  .project-index-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 27px;
  }
  .project-index-meta .page-count {
    margin-top: 0;
  }
  .build-note a {
    color: var(--accent);
    margin-left: 6px;
  }
  @media (max-width: 520px) {
    .project-index-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
